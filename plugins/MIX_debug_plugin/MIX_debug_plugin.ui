   <property name="styleSheet">
    <string notr="true">QWidget#centralWidget { background: #f4f5f7; }
QLabel#panelTitle { font-weight: bold; color: #555555; padding: 2px 2px; }
QLineEdit { background: #ffffff; border: 1px solid #d0d0d0; border-radius: 4px; padding: 4px 8px; font-size: 13px; }
QLineEdit:focus { border-color: #0078d4; }
QTextEdit#cmdInfoText { border: 1px solid #d0d0d0; border-radius: 4px; background: #fafafa; color: #444444; font-size: 12px; }
QTextEdit#logText { font-family: &quot;SF Mono&quot;, Menlo, monospace; font-size: 12px; background: #1e1e1e; color: #d4d4d4; border: none; }
QTabWidget::pane { border: 1px solid #d0d0d0; border-radius: 4px; }
QTabBar::tab { padding: 4px 14px; font-size: 12px; background: transparent; }
QTabBar::tab:selected { color: #0078d4; border-bottom: 2px solid #0078d4; }
QListWidget { border: 1px solid #d0d0d0; border-radius: 4px; font-size: 12px; background: #ffffff; }
QListWidget::item { padding: 4px 6px; }
QListWidget::item:selected { background: #e8f0fe; color: #0078d4; }
QTableWidget { border: 1px solid #d0d0d0; gridline-color: #eeeeee; font-size: 12px; background: #ffffff; }
QHeaderView::section { font-size: 12px; padding: 4px; background: #f5f5f5; border: none; border-bottom: 1px solid #d0d0d0; }
QPushButton { border: 1px solid #cccccc; border-radius: 4px; padding: 3px 10px; background: #ffffff; color: #444444; font-size: 12px; }
QPushButton:hover { border-color: #0078d4; color: #0078d4; }
QPushButton:pressed { background: #eef4fb; }
QPushButton#primaryButton { background: #0078d4; color: #ffffff; border: none; border-radius: 4px; padding: 5px 18px; font-size: 13px; }
QPushButton#primaryButton:hover { background: #106ebe; color: #ffffff; }
QPushButton#primaryButton:pressed { background: #005a9e; color: #ffffff; }
QPushButton#accentButton { background: #e8f0fe; color: #0078d4; border: 1px solid #b6d3f5; border-radius: 4px; padding: 6px 16px; font-size: 13px; }
QPushButton#accentButton:hover { background: #d6e6fb; }
QPushButton#accentButton:pressed { background: #c2d9f7; }</string>
